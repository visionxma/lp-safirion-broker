{
  // Site 100% estático servido pelo Workers Static Assets: não há `main`,
  // então não existe Worker rodando — a Cloudflare serve os arquivos direto.
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "lp-safirion-broker",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./",
    // sem SPA: rota inexistente devolve 404 de verdade, que é o certo
    // para uma landing page de uma página só
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
