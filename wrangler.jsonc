{
  // Site 100% estático servido pelo Workers Static Assets: não há `main`,
  // então não existe Worker rodando — a Cloudflare serve os arquivos direto.
  //
  // `directory` aponta para ./public/ de propósito: apontar para ./ subia
  // o .git/ e os backups .bak-* junto, deixando-os acessíveis em produção.
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "lp-safirion-broker",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./public/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
