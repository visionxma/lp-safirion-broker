# =============================================================================
#  Safirion — configuracao de Apache (cPanel)
#
#  Traduz para Apache o que no Cloudflare vinha de public/_redirects e
#  public/_headers, arquivos que so o Cloudflare le. Nao suba aqueles dois:
#  aqui eles nao fazem nada.
# =============================================================================

# ----------------------------------------------------------------- redirects
# Vindos de _redirects, com os mesmos codigos 301. Preservam as URLs que o
# safirion.com ja tem indexadas — sem isso viram 404 e o historico de busca
# vai junto.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> apex, preservando o esquema.
  #
  # Sem isto o mesmo conteudo responde em quatro enderecos: com e sem www,
  # em http e em https. O canonical aponta todos para o apex em https, mas
  # o Google ainda escolhe o que rastreia — e escolheu http://www.safirion.com,
  # que foi o que apareceu no resultado de busca com o titulo antigo.
  #
  # Preserva o esquema de proposito: mandar para https aqui quebraria o www
  # enquanto o certificado nao estiver ativo.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ %{REQUEST_SCHEME}://%1/$1 [R=301,L]

  # HTTPS + apex numa tacada so. Troque as duas linhas acima por estas tres
  # DEPOIS de confirmar o AutoSSL no cPanel — assim http://www vira
  # https://safirion.com num salto so, em vez de dois.
  # Ligar isto sem certificado deixa o site inacessivel.
  #
  # RewriteCond %{HTTPS} !=on [OR]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteRule ^(.*)$ https://safirion.com/$1 [R=301,L]

  # O site chama /api/cotacoes e /api/noticias sem extensao, como no Worker.
  # Reescrita interna: a URL vista pelo navegador continua a mesma.
  RewriteRule ^api/(cotacoes|noticias)/?$ /api/$1.php [L]

  # a raiz servia com canonical para /en/; aqui o publico e Brasil
  RewriteRule ^$ /pt/ [R=301,L]

  # variantes sem barra final
  RewriteRule ^(pt|en|es|fr|blog)$ /$1/ [R=301,L]

</IfModule>

# ------------------------------------------------------------------- headers
<IfModule mod_headers.c>
  # O HTML precisa revalidar, senao uma atualizacao demora a chegar no visitante
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS: so depois que o HTTPS estiver funcionando e forcado acima.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --------------------------------------------------------------------- resto
ErrorDocument 404 /404.html

# O Apache tem MultiViews desligado por padrao em muitos cPanel, mas quando
# esta ligado ele resolve /terms para /terms.html sozinho e cria uma segunda
# URL para a mesma pagina. Desligar mantem uma URL so, que e a do sitemap.
Options -MultiViews -Indexes

# AddOutputFilterByType vem do mod_filter, NAO do mod_deflate — guardar so
# pelo deflate deixa passar num servidor sem o filter e derruba tudo com 500.
# Verificado num Apache 2.4 local: com so o deflate carregado, toda a pagina
# respondia 500.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
      application/javascript application/json image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
